datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Campaign {
  id               String    @id @default(uuid())
  name             String
  platform         String // "whatsapp", "instagram", "facebook", "sms"
  provider         String? // e.g., "twilio", "vonage", "telnyx"
  providerConfig   String? // JSON string storing Twilio Account SID, Auth Token, From Number
  message          String
  metaToken        String? // Access token for Meta Graph API
  adminId          String? // Phone Number ID (WhatsApp) or Page ID (FB/IG)
  isTemplate       Boolean   @default(false)
  templateLanguage String?
  messageTag       String?
  subject          String? // Email subject line
  audioUrl         String? // URL of the uploaded recording for voice campaigns
  status           String    @default("pending") // "pending", "running", "completed", "failed", "scheduled"
  scheduledAt      DateTime?
  segmentId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  logs    MessageLog[]
  segment Segment?     @relation(fields: [segmentId], references: [id])
}

model MessageLog {
  id          String   @id @default(uuid())
  campaignId  String
  contact     String // phone number or username
  status      String // "pending", "success", "failed", "delivered", "ringing", "answered", "no-answer", "busy"
  error       String?
  ivrResponse String? // The digit pressed by the user (e.g., "1", "2")
  duration    Int? // Call duration in seconds
  providerId  String? // ID returned by Twilio/Vonage to correlate webhooks
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Contact {
  id         String    @id @default(uuid())
  phone      String?   @unique
  email      String?   @unique
  lineId     String?   @unique
  firstName  String?
  lastName   String?
  isOptedOut Boolean   @default(false)
  segments   Segment[] @relation("ContactSegments")
  createdAt  DateTime  @default(now())
}

model Segment {
  id        String     @id @default(uuid())
  name      String
  contacts  Contact[]  @relation("ContactSegments")
  campaigns Campaign[]
}

model SmsReply {
  id         String   @id @default(uuid())
  campaignId String?
  fromNumber String
  message    String
  provider   String
  receivedAt DateTime @default(now())
}
